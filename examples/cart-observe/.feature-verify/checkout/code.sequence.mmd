sequenceDiagram
  actor Shopper
  box Client
    participant UI as Shop page
  end
  box Server
    participant API as server.js
    participant Cart as cart.js
    participant Store as store.js (memory)
  end
  UI->>API: GET /api/products
  %% @ref public/index.html:6#/api/products
  API-->>UI: 200 products incl. stock
  %% @ref src/server.js:12#products
  UI->>API: GET /api/cart
  %% @ref public/index.html:8#/api/cart
  API-->>UI: 200 {lines, total}
  %% @ref src/server.js:13#cartView
  Shopper->>UI: Click Add
  %% @ref public/index.html:10#onclick
  UI->>API: POST /api/cart {productId, qty: 1}
  %% @ref public/index.html:12#/api/cart
  API->>Cart: addItem(productId, qty)
  %% @ref src/server.js:16#addItem
  alt unknown product
    Cart-->>API: 404 no-such-product
    %% @ref src/cart.js:5#no-such-product
  else qty not a positive integer
    Cart-->>API: 400 bad-qty
    %% @ref src/cart.js:6#bad-qty
  else product.stock < qty (this request only)
    Cart-->>API: 409 out-of-stock
    %% @ref src/cart.js:7#out-of-stock
  else
    Cart->>Store: add or increase cart line
    %% @ref src/cart.js:9#cart.items
    Cart-->>API: 200 {lines, total}
    %% @ref src/cart.js:10#cartView
  end
  API-->>UI: same status + body
  %% @ref src/server.js:17#send
  Shopper->>UI: Click Checkout
  %% @ref public/index.html:16#checkout
  UI->>API: POST /api/checkout
  %% @ref public/index.html:17#/api/checkout
  API->>Cart: checkout()
  %% @ref src/server.js:20#checkout
  alt cart empty
    Cart-->>API: 409 empty-cart
    %% @ref src/cart.js:19#empty-cart
  else
    Cart->>Store: stock -= qty for every line (no floor)
    %% @ref src/cart.js:21#stock
    Cart->>Store: push order, empty cart
    %% @ref src/cart.js:23#orders.push
    Cart-->>API: 201 {orderId, total}
    %% @ref src/cart.js:24#orderId
  end
  API-->>UI: same status + body
  %% @ref src/server.js:21#send
  Note over Cart,Store: stock is checked per request, not against qty already in the cart
